// PwedePa schema source of truth. scripts/render_schema.py draws docs/schema.md
// from this file, and pwedepa/data/schema.sql must stay executable.

Project pwedepa {
  database_type: 'SQLite'
  Note: 'One database holds requests, issues, auth, sharing, and notices.'
}

Table domains {
  id integer [pk, increment]
  name text [not null, unique]
  slug text [not null, unique]
  description text [not null, default: '']
  created_at text
  updated_at text
}

Table domain_redirects {
  old_slug text [pk]
  slug text [not null]
}

Table requests {
  id integer [pk]
  title text [not null]
  description text [not null]
  status text [not null]
  requester_id integer
  priority_suggestion text
  priority_unsure integer [not null, default: 0]
  visibility text [not null]
  domains text [not null, default: '[]']
  created_at text
  updated_at text
  deleted_at text
}

Table issues {
  id integer [pk]
  title text [not null]
  description text [not null]
  status text [not null]
  source_request_id integer
  requester_id integer
  assignee_id integer
  priority text [not null]
  visibility text [not null]
  domains text [not null, default: '[]']
  created_at text
  updated_at text
  deleted_at text
}

Table events {
  id integer [pk, increment]
  object_type text [not null]
  object_id integer [not null]
  event_type text [not null]
  actor_id integer
  at text
  data text [not null, default: '{}']

  Note: 'Polymorphic trail. object_type names requests or issues.'
}

Table users {
  id integer [pk, increment]
  username text [not null, unique]
  display_name text [not null]
  status text [not null]
  created_at text [not null]
  updated_at text [not null]
  archived_at text
}

Table user_roles {
  user_id integer [not null]
  role text [not null]
  created_at text [not null]

  indexes {
    (user_id, role) [pk]
  }
}

Table permission_grants {
  id integer [pk, increment]
  user_id integer [not null]
  permission text [not null]
  effect text [not null]
  created_at text [not null]
  revoked_at text

  indexes {
    (user_id, permission, effect) [unique]
  }
}

Table passkeys {
  id integer [pk, increment]
  user_id integer [not null]
  credential_id blob [not null, unique]
  public_key blob [not null]
  sign_count integer [not null]
  created_at text [not null]
  last_used_at text
  revoked_at text
}

Table webauthn_challenges {
  id text [pk]
  user_id integer
  ceremony text [not null]
  challenge blob [not null]
  created_at text [not null]
  expires_at text [not null]
  used_at text
}

Table enrollment_tokens {
  id integer [pk, increment]
  role text [not null]
  token_hash text [not null, unique]
  created_at text [not null]
  expires_at text [not null]
  used_at text
}

Table sessions {
  id integer [pk, increment]
  user_id integer [not null]
  token_hash text [not null, unique]
  created_at text [not null]
  expires_at text [not null]
  last_used_at text
  revoked_at text
  replaced_by_id integer
}

Table audit_events {
  id integer [pk, increment]
  actor_id integer
  event_type text [not null]
  object_type text
  object_id integer
  data text [not null, default: '{}']
  created_at text [not null]
}

Table share_links {
  id integer [pk, increment]
  object_type text [not null]
  object_id integer [not null]
  token_hash text [not null, unique]
  permissions text [not null, default: '[]']
  created_by_id integer [not null]
  created_at text [not null]
  expires_at text
  revoked_at text
  view_consumed_at text
}

Table notifications {
  id integer [pk, increment]
  user_id integer [not null]
  category text [not null]
  object_type text
  object_id integer
  message text [not null]
  actor_id integer
  created_at text [not null]
}

Table notification_preferences {
  user_id integer [not null]
  category text [not null]
  enabled integer [not null, default: 1]
  inbox_enabled integer [not null, default: 1]
  pip_enabled integer [not null, default: 1]

  indexes {
    (user_id, category) [pk]
  }
}

Table user_preferences {
  user_id integer [pk]
  clock text [not null, default: '12']
  theme text [not null, default: 'system']
}

Table site_messages {
  id integer [pk, increment]
  message text [not null]
  enabled integer [not null, default: 1]
  created_at text [not null]
  updated_at text [not null]
  expires_at text
  created_by_id integer
}

Table announcements {
  id integer [pk, increment]
  domain text [not null]
  title text [not null]
  body text [not null]
  author_id integer [not null]
  published_at text [not null]
  edited_at text

  Note: 'domain holds the Domain slug, so a rename keeps every post.'
}

Table domain_subscriptions {
  user_id integer [not null]
  domain text [not null]

  indexes {
    (user_id, domain) [pk]
  }
}

Table workspace_reads {
  user_id integer [not null]
  object_type text [not null]
  object_id integer [not null]
  read_at text [not null]

  indexes {
    (user_id, object_type, object_id) [pk]
  }
}

Ref: requests.requester_id > users.id
Ref: issues.source_request_id > requests.id
Ref: issues.requester_id > users.id
Ref: issues.assignee_id > users.id
Ref: user_roles.user_id > users.id
Ref: permission_grants.user_id > users.id
Ref: passkeys.user_id > users.id
Ref: webauthn_challenges.user_id > users.id
Ref: sessions.user_id > users.id
Ref: sessions.replaced_by_id > sessions.id
Ref: share_links.created_by_id > users.id
Ref: notifications.user_id > users.id
Ref: notification_preferences.user_id > users.id
Ref: user_preferences.user_id > users.id
Ref: site_messages.created_by_id > users.id
Ref: announcements.author_id > users.id
Ref: domain_subscriptions.user_id > users.id
Ref: workspace_reads.user_id > users.id
