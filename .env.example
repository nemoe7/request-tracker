# Copy this file to .env and fill in your own values. Compose reads .env on its own.
#
# The public name of the Funnel host. Passkeys bind to it, so set it before the
# first start. The sidecar calls its node pwedepa, so read your tailnet name from
# `docker compose logs tailscale` after the first start.
PWEDEPA_RP_ID=pwedepa.your-tailnet.ts.net
PWEDEPA_ORIGIN=https://pwedepa.your-tailnet.ts.net

# The name shown in the passkey prompt.
PWEDEPA_RP_NAME=PwedePa

# Signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
PWEDEPA_SECRET_KEY=

# The Tailscale auth key for the sidecar. Mint a reusable, untagged key in the
# admin console, so the node carries no ACL tags.
TS_AUTHKEY=
