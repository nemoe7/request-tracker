# Copy this file to .env. `compose.yml` reads it. `compose.dev.yml` runs without it.

# The public name. Passkeys bind to it, so set it before the first start.
PWEDEPA_ORIGIN=https://pwedepa.your-tailnet.ts.net

# Optional: set this only when the passkey ID must differ from the origin host.
PWEDEPA_RP_ID=

# The name in the passkey prompt.
PWEDEPA_RP_NAME=PwedePa

# Signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
PWEDEPA_SECRET_KEY=

# The Tailscale auth key for the sidecar. Mint a reusable, untagged key.
TS_AUTHKEY=
