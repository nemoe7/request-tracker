{% extends "base.jinja" %}
{% block title %}PwedePa | Edit issue #{{ record.id }}{% endblock %}
{% block content %}
<div class="narrow">
  <h1>Edit issue</h1>
  <form class="form panel" method="post" action="{{ url_for('records.issue_edit_save', issue_id=record.id) }}">
    <div class="field">
      <label for="i-title">Title</label>
      <input id="i-title" name="title" type="text" required value="{{ record.title }}">
    </div>
    <div class="field">
      <label for="i-description">Description</label>
      <textarea id="i-description" name="description" rows="5">{{ record.description }}</textarea>
    </div>
    <fieldset class="field field-checks">
      <legend>Domains</legend>
      {% for domain in domains %}
      <label class="check"><input id="i-domains-{{ loop.index }}" type="checkbox" name="domains" value="{{ domain.name }}"{% if record and domain.name in record.domains %} checked{% endif %}> {{ domain.name }}</label>
      {% else %}
      <p class="help">No Domain is configured.</p>
      {% endfor %}
    </fieldset>
    <div class="field">
      <label for="i-visibility">Visibility</label>
      <select id="i-visibility" name="visibility">
        <option value="PRIVATE"{% if record.visibility.value == 'PRIVATE' %} selected{% endif %}>Private</option>
        <option value="PUBLIC"{% if record.visibility.value == 'PUBLIC' %} selected{% endif %}>Public</option>
      </select>
    </div>
    <div class="field">
      <label for="i-priority">Priority</label>
      <select id="i-priority" name="priority">
        {% for value in priorities %}
        <option value="{{ value }}"{% if record.priority.value == value %} selected{% endif %}>{{ value | capitalize }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="field">
      <label for="i-assignee">Assignee</label>
      <select id="i-assignee" name="assignee_id">
        <option value="">Unassigned</option>
        {% for person in users %}
        <option value="{{ person.id }}"{% if record.assignee_id == person.id %} selected{% endif %}>{{ person.display_name }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="form-actions">
      <button class="btn primary icon-only" type="submit" aria-label="Save changes" title="Save changes"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#check"/></svg></button>
      <a class="btn" href="{{ record_path(record, 'issue') }}">Cancel</a>
    </div>
  </form>
</div>
{% endblock %}
