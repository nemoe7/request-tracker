{% macro pill(status) -%}
<span class="pill st-{{ status.value | lower }}"><span class="dot" aria-hidden="true"></span>{{ status.value | capitalize }}</span>
{%- endmacro %}
{% macro event_line(event, names) -%}
<li class="event">
  <span class="event-what">
    {%- if event.event_type.endswith("state_changed") -%}
    Moved {{ event.data.get("from", "") }} to {{ event.data.get("to", "") }}
    {%- if event.data.get("reason") %}: {{ event.data["reason"] }}{% endif %}
    {%- elif event.event_type.endswith("priority_changed") -%}
    Priority {{ event.data.get("from", "") }} to {{ event.data.get("to", "") }}
    {%- elif event.event_type.endswith("edited") -%}
    Edited {{ event.data.get("fields", []) | join(", ") }}
    {%- elif event.event_type.endswith("raised_from_request") -%}
    Raised into Issue #{{ event.data.get("issue_id", "") }}
    {%- elif event.event_type.endswith("comment") -%}
    Comment added
    {%- elif event.event_type.endswith("created") -%}
    Created
    {%- else -%}
    {{ event.event_type }}
    {%- endif -%}
  </span>
  <span class="event-meta">{{ names.get(event.actor_id, "Someone") }} · {{ event.at | stamp_time(clock) }}</span>
</li>
{%- endmacro %}

{% macro confirm_modal(id, action, title, body, submit) -%}
{% call modal(id, title) %}
<form class="modal-form" method="post" action="{{ action }}">
  <p>{{ body }}</p>
  <div class="modal-actions">
    <button class="btn" type="button" data-modal-close autofocus>Cancel</button>
    <button class="btn danger" type="submit">{{ submit }}</button>
  </div>
</form>
{% endcall %}
{%- endmacro %}

{% macro modal(id, title, open=false) -%}
<dialog class="modal modal-shell" id="{{ id }}" aria-labelledby="{{ id }}-title"{% if open %} data-modal-open-init{% endif %}>
  <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="{{ id }}-title">
    <div class="modal-head">
      <h2 id="{{ id }}-title">{{ title }}</h2>
      <button class="icon-btn modal-close" type="button" data-modal-close aria-label="Close dialog" title="Close dialog"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#x"/></svg></button>
    </div>
    {{ caller() }}
  </div>
</dialog>
{%- endmacro %}

{% macro reason_modal(id, action, fields, next_href, title="Revoke this?", submit="Revoke", hint="Reason for revoking") -%}
{% call modal(id, title) %}
<form class="modal-form" method="post" action="{{ action }}">
  {% for name, value in fields.items() %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endfor %}
  {% if next_href %}<input type="hidden" name="next" value="{{ next_href }}">{% endif %}
  <label for="{{ id }}-reason">Reason</label>
  <textarea id="{{ id }}-reason" name="reason" rows="3" required autofocus placeholder="{{ hint }}"></textarea>
  <div class="modal-actions">
    <button class="btn" type="button" data-modal-close>Cancel</button>
    <button class="btn danger" type="submit">{{ submit }}</button>
  </div>
</form>
{% endcall %}
{%- endmacro %}
