{# nonemo: HMN905 #}
{% extends "base.jinja" %}
{% from "_parts.jinja" import pill %}
{% block title %}PwedePa | Shared {{ object_type }} #{{ record.id }}{% endblock %}
{% block body_class %} class="is-guest is-share"{% endblock %}
{% block content %}
<article class="issue-page">
  <header class="issue-head">
    <div class="issue-title-row">
      <div class="issue-title-text">
        <p class="eyebrow">Shared {{ object_type }}</p>
        <div class="issue-title-line">
          <h1><span class="issue-number">#{{ record.id }}</span> {{ record.title }}</h1>
          {{ pill(record.status) }}
        </div>
        <p class="byline">
          <span>{{ (record.created_at | stamp_time(clock)) if record.created_at else "—" }}</span>
          <span class="sep">·</span>
          <span>{{ record.visibility.value | capitalize }}</span>
        </p>
      </div>
    </div>
  </header>

  <div class="issue-layout">
    <div class="issue-main">
      <ol class="timeline">
        <li class="timeline-comment is-body">
          <div class="prose">{{ record.description | prose if record.description else "No description." }}</div>
          <p class="event-meta">{{ record.created_at | stamp_time(clock) }}</p>
        </li>
        {% for event in comments %}
        <li class="timeline-comment">
          <p>{{ event.data.get("text", "") }}</p>
          <p class="event-meta">{{ event.at | stamp_time(clock) }}</p>
        </li>
        {% endfor %}
      </ol>
      {% if not comments %}
      <p class="muted">No comments yet.</p>
      {% endif %}
    </div>

    <aside class="issue-side" aria-label="Shared record facts">
      <section class="side-block">
        <h2>Labels</h2>
        <p class="labels">{% for name in record.domains %}{% if not loop.first %} {% endif %}<span>{{ name }}</span>{% else %}<span class="muted">None</span>{% endfor %}</p>
      </section>
      <section class="side-block">
        <h2>Priority</h2>
        <p>{% if object_type == "request" %}{% if record.priority_suggestion %}{{ record.priority_suggestion.value | capitalize }}{% else %}—{% endif %}{% else %}{{ record.priority.value | capitalize }}{% endif %}</p>
      </section>
      <section class="side-block">
        <h2>Details</h2>
        <dl class="facts">
          <div><dt>Shared link</dt><dd>{{ link.permissions | join(", ") | capitalize }}</dd></div>
          <div><dt>Updated</dt><dd>{{ (record.updated_at | stamp_time(clock)) if record.updated_at else "—" }}</dd></div>
        </dl>
      </section>
    </aside>
  </div>
</article>
{% endblock %}
