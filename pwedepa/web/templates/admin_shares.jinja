{% extends "base.jinja" %}
{% block title %}PwedePa | Admin share links{% endblock %}
{% block content %}
<div class="admin-page">
<div class="page-head">
  <h1>Share links</h1>
  <a class="btn" href="{{ url_for('admin.overview') }}">Admin home</a>
</div>
{% if share_links %}
<ul class="record-list">
  {% for link in share_links %}
  <li class="record-row">
    <div class="record-row-main">
      <h2>{{ link.object_type | capitalize }} #{{ link.object_id }}</h2>
      <p class="meta">Link #{{ link.id }} · {{ link.permissions | join(", ") }} · created by {{ names.get(link.created_by_id, "—") }}</p>
    </div>
    <div class="record-row-side">
      <span class="status-word">{% if link.revoked_at %}Revoked{% elif link.view_consumed_at %}View used{% else %}Active{% endif %}</span>
      {% if not link.revoked_at %}<form method="post" action="{{ url_for('sharing.revoke', link_id=link.id) }}"><button class="btn danger" type="submit">Revoke</button></form>{% endif %}
    </div>
  </li>
  {% endfor %}
</ul>
{% else %}
<p class="muted">No share links yet.</p>
{% endif %}
</div>
{% endblock %}
