{% extends "base.jinja" %}
{% from "_parts.jinja" import pill, event_line %}
{% block title %}PwedePa | Workspace{% endblock %}
{% block content %}
<div class="workspace-grid{% if selected %} is-open is-main{% endif %}">
  <aside class="panel filters" aria-label="Queue filters">
    <input class="filters-toggle" type="checkbox" id="filters-toggle">
    <label class="filters-row" for="filters-toggle">Filters<svg class="icon chev" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#chevron-right"/></svg></label>
    <div class="filters-body">
      <h2>Queue</h2>
      {% for key, label in [("triage", "Needs triage"), ("assigned", "Assigned to me"), ("blocked", "Blocked"), ("public", "Public")] %}
      <a class="queue-item{% if queue == key %} is-active{% endif %}" href="{{ url_for('records.workspace', queue=key, domain=domain, visibility=visibility, status=status_filter) }}">{{ label }}<span class="count">{{ counts[key] }}</span></a>
      {% endfor %}
      <h2>Domain</h2>
      <a class="queue-item{% if not domain %} is-active{% endif %}" href="{{ url_for('records.workspace', queue=queue, visibility=visibility, status=status_filter) }}">All domains</a>
      {% for name in domains %}
      <a class="queue-item{% if domain == name %} is-active{% endif %}" href="{{ url_for('records.workspace', queue=queue, domain=name, visibility=visibility, status=status_filter) }}">{{ name }}</a>
      {% endfor %}
      <h2>Visibility</h2>
      <div class="seg" role="group" aria-label="Visibility filter">
        <a{% if not visibility %} class="is-active"{% endif %} href="{{ url_for('records.workspace', queue=queue, domain=domain, status=status_filter) }}">All</a>
        <a{% if visibility == "PUBLIC" %} class="is-active"{% endif %} href="{{ url_for('records.workspace', queue=queue, domain=domain, visibility='PUBLIC', status=status_filter) }}">Public</a>
        <a{% if visibility == "PRIVATE" %} class="is-active"{% endif %} href="{{ url_for('records.workspace', queue=queue, domain=domain, visibility='PRIVATE', status=status_filter) }}">Private</a>
      </div>
    </div>
  </aside>

  <section class="panel records" aria-label="Records">
    <div class="list-toolbar">
      <h1>Workspace</h1>
      <div class="list-actions">
      <form class="filter-form" method="get" action="{{ url_for('records.workspace') }}" data-auto-submit>
        <input type="hidden" name="queue" value="{{ queue }}">
        <input type="hidden" name="domain" value="{{ domain }}">
        <input type="hidden" name="visibility" value="{{ visibility }}">
        <label class="sr-only" for="status-filter">Status</label>
        <select id="status-filter" name="status">
          <option value="">All statuses</option>
          {% for value in statuses %}
          <option value="{{ value }}"{% if status_filter == value %} selected{% endif %}>{{ value | capitalize }}</option>
          {% endfor %}
        </select>
        <noscript><button class="btn" type="submit"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#check"/></svg>Apply status</button></noscript>
      </form>
      <a class="btn" href="{{ url_for('records.issue_board') }}">Issues</a>
      </div>
    </div>

    {% if rows %}
    <table class="record-table mail-table">
      <thead>
        <tr><th>{{ "Requester" if row_kind == "request" else "Person" }}</th><th>{{ "Request" if row_kind == "request" else "Issue" }}</th><th>Status</th><th>Time</th></tr>
      </thead>
      <tbody>
        {% for row in rows %}
        <tr class="mail-row{% if row.id not in read_ids %} is-unread{% endif %}{% if selected and row.id == selected.id and row_kind == "request" %} is-selected{% endif %}">
          <td class="mail-from">{{ names.get(row.requester_id, "—") }}</td>
          <td class="mail-title">
            {% if row_kind == "request" %}
            <a class="mail-link" href="{{ url_for('records.workspace', queue=queue, domain=domain, visibility=visibility, status=status_filter, selected=row.id) }}"{% if selected and row.id == selected.id %} aria-current="true"{% endif %}>{{ row.title }}</a>
            <span class="mail-snippet">{{ row.description | plain_prose | truncate(140, true) }}</span>
            {% else %}
            <a class="mail-link" href="{{ record_path(row, 'issue') }}">{{ row.title }}</a>
            <span class="mail-snippet">Issue #{{ row.id }} · {{ row.domains | join(", ") or "—" }}</span>
            {% endif %}
          </td>
          <td class="mail-status">{{ pill(row.status) }}</td>
          <td class="mail-time">{{ (row.updated_at | stamp(clock)) if row.updated_at else "—" }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p class="muted">Nothing here yet.</p>
    {% endif %}
  </section>

  <aside class="panel inspector{% if selected %} is-main{% endif %}" aria-label="Request">
    {% if selected %}
    {% set back_href = url_for('records.workspace', queue=queue, domain=domain, visibility=visibility, status=status_filter) %}
    {% set record = selected %}
    {% set actions = selected_actions %}
    {% set can_edit = selected_can_edit %}
    {% set can_comment = selected_can_comment %}
    {% set events = selected_events %}
    {% set share_links = selected_share_links %}
    {% set can_share = selected_can_share %}
    {% set object_type = "request" %}
    {% set issued_token = selected_token %}
    {% set pane = true %}
    {% set next_href = return_to %}
    {% include "_request_view.jinja" %}
    {% else %}
    <div class="empty">
      <img src="{{ url_for('static', filename='icons/icon-static.png') }}" alt="" width="48" height="48">
      <p>Select a record to inspect it.</p>
    </div>
    {% endif %}
  </aside>
</div>
{% endblock %}
