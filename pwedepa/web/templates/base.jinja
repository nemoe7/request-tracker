<!doctype html>
<html lang="en" data-theme="{{ theme }}" data-font-size="{{ font_size }}" data-theme-scope="{{ 'account' if user else 'browser' }}" data-theme-endpoint="{{ url_for('settings.theme') }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}PwedePa{% endblock %}</title>
  <meta name="theme-color" content="#2563EB">
  <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ url_for('static', filename='fonts/inter-latin-400-normal.woff2') }}">
  <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ url_for('static', filename='fonts/inter-latin-600-normal.woff2') }}">
  <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ url_for('static', filename='fonts/inter-latin-800-normal.woff2') }}">
  <link rel="manifest" href="{{ url_for('static', filename='manifest.webmanifest') }}">
  <link rel="icon" type="image/png" href="{{ url_for('static', filename='icons/icon-static.png') }}">
  <script>
    (function () {
      var root = document.documentElement;
      if (root.dataset.themeScope === "browser") {
        root.dataset.theme =
          localStorage.getItem("pwedepa-theme") || root.dataset.theme;
      } else {
        localStorage.setItem("pwedepa-theme", root.dataset.theme);
      }
      var size = Number(root.dataset.fontSize) || 100;
      root.style.setProperty("--font-scale", String(size / 100));
    })();
  </script>
  <link rel="stylesheet" href="{{ url_for('static', filename='tokens.css') }}">
  <link rel="stylesheet" href="{{ url_for('static', filename='app.css') }}">
</head>
<body{% block body_class %}{% if is_staff %} class="is-staff"{% elif not user %} class="is-guest"{% endif %}{% endblock %}>
  {% if user %}
  <header class="topbar">
    <a class="brand" href="{{ url_for('records.workspace') }}">
      <span class="app-icon" aria-hidden="true">
        <img class="icon-static" src="{{ url_for('static', filename='icons/icon-static.png') }}" alt="">
        <img class="icon-animated" data-src="{{ url_for('static', filename='icons/icon-animated.webp') }}" alt="">
      </span>
      <span class="brand-text">
        <span class="brand-name">PwedePa</span>
        <span class="brand-version">{{ build_label() }}</span>
      </span>
    </a>
    {% if not is_staff %}
    <nav class="tabs" aria-label="Main">
      <a href="{{ url_for('records.requests') }}"{% if request.endpoint == 'records.requests' %} class="is-active" aria-current="page"{% endif %}><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#clipboard-list"/></svg>Requests</a>
      <a href="{{ url_for('records.issue_board') }}"{% if request.endpoint == 'records.issue_board' %} class="is-active" aria-current="page"{% endif %}><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#circle-alert"/></svg>Issues</a>
    </nav>
    {% endif %}
    <div class="top-actions">
      {% if user %}
      {% if is_staff %}
      <a class="bell" href="{{ url_for('records.request_new') }}" aria-label="New request" title="New request"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#plus"/></svg></a>
      {% endif %}
      <a class="bell" href="{{ url_for('notifications.inbox') }}" aria-label="Notifications"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#bell"/></svg>{% if notification_count %}<span class="pip">{{ notification_count }}</span>{% endif %}</a>
      <div class="user-menu-wrap">
        <button class="avatar avatar-btn" id="user-menu-button" type="button" aria-haspopup="true" aria-expanded="false" aria-label="Account menu">{{ user.display_name[0] }}</button>
        <div class="user-menu" id="user-menu" hidden>
          <p class="user-menu-id"><strong>{{ user.display_name }}</strong><span>@{{ user.username }}</span></p>
          {% if demo_switch %}
          <nav class="demo-switch" aria-label="Demo seat">
            <a href="{{ url_for('records.workspace') }}"{% if is_staff %} class="on"{% endif %}>Staff</a>
            <a href="{{ url_for('pages.home') }}"{% if not is_staff %} class="on"{% endif %}>Client</a>
          </nav>
          {% endif %}
          <a class="user-menu-item" href="{{ url_for('settings.settings') }}"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#settings"/></svg>Settings</a>
          <button class="user-menu-item" id="logout-button" type="button"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#log-out"/></svg>Sign out</button>
        </div>
      </div>
      {% endif %}
    </div>
  </header>
  {% endif %}
  <main class="wrap">
    {% if view_as_client %}
    <div class="flash" role="status"><p>Client view · read-only requests and issues · <a href="{{ url_for('pages.view_as', mode='staff') }}">Exit</a></p></div>
    {% endif %}
    {% with messages = get_flashed_messages() %}
    {% if messages %}
    <div class="flash" role="status">
      {% for message in messages %}<p>{{ message }}</p>{% endfor %}
    </div>
    {% endif %}
    {% endwith %}
    {% block content %}{% endblock %}
  </main>
  <dialog id="modal-shell" class="modal modal-shell" aria-labelledby="modal-title">
    <form id="modal-form" method="dialog" class="modal-card">
      <header class="modal-head">
        <h2 id="modal-title"></h2>
        <button type="submit" value="cancel" class="icon-btn modal-close" aria-label="Close dialog" title="Close dialog"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#x"/></svg></button>
      </header>
      <div id="modal-body" class="modal-body"></div>
      <footer id="modal-actions" class="modal-actions"></footer>
    </form>
  </dialog>
  <template data-modal-template="confirm">
    <p data-slot="message"></p>
    <div data-slot="actions">
      <button type="submit" value="cancel" class="btn" autofocus>Cancel</button>
      <button type="submit" value="confirm" class="btn danger" data-slot="confirm-label">Confirm</button>
    </div>
  </template>
  <script src="{{ url_for('static', filename='app.js') }}"></script>
</body>
</html>
