{% extends "base.jinja" %}
{% from "_parts.jinja" import pill, event_line %}
{% block title %}PwedePa | Issue #{{ record.id }}{% endblock %}
{% block content %}
<article class="issue-page">
  <header class="issue-head">
    <div class="issue-title-line">
      <h1><span class="issue-number">#{{ record.id }}</span> {{ record.title }}</h1>
      {{ pill(record.status) }}
    </div>
    <p class="byline">
      <span>{{ names.get(record.requester_id, "—") }}</span>
      <span class="sep">·</span>
      <span>{{ (record.created_at | stamp_time(clock)) if record.created_at else "—" }}</span>
      <span class="sep">·</span>
      <span>{{ record.visibility.value | capitalize }} · {{ record.priority.value | capitalize }} priority</span>
    </p>
    <div class="issue-bar">
      {% if actions or can_edit %}
      <div class="issue-actions">
        {% if actions %}
        <form class="actions" method="post" action="{{ url_for('records.issue_transition', issue_id=record.id) }}">
          {% for target, label in actions %}
          <button class="btn" type="submit" name="target" value="{{ target }}">{{ label }}</button>
          {% endfor %}
        </form>
        {% endif %}
        {% if can_edit %}<a class="icon-btn" href="{{ url_for('records.issue_edit', issue_id=record.id) }}" aria-label="Edit" title="Edit"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#pencil"/></svg></a>{% endif %}
      </div>
      {% endif %}
    </div>
  </header>

  <div class="issue-layout">
    <div class="issue-main">
      <ol class="timeline">
        <li class="timeline-comment is-body">
          <div class="prose">{{ record.description | prose if record.description else "No description." }}</div>
          <p class="event-meta">{{ names.get(record.requester_id, "Someone") }} · {{ (record.created_at | stamp_time(clock)) if record.created_at else "—" }}</p>
        </li>
        {% for event in events %}
        {% if event.event_type == "issue.comment" %}
        <li class="timeline-comment">
          <p>{{ event.data.get("text", "") }}</p>
          <p class="event-meta">{{ names.get(event.actor_id, "Someone") }} · {{ event.at | stamp_time(clock) }}</p>
        </li>
        {% elif not event.event_type.endswith("created") %}
        {{ event_line(event, names) }}
        {% endif %}
        {% endfor %}
      </ol>

      {% if can_comment %}
      <form class="comment-form" method="post" action="{{ url_for('records.issue_comment', issue_id=record.id) }}">
        <label for="issue-comment-text">Add a comment</label>
        <textarea id="issue-comment-text" name="text" rows="3" required></textarea>
        <button class="btn primary" type="submit"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#message-square"/></svg>Comment</button>
      </form>
      {% endif %}

      {% include "_sharing.jinja" %}
    </div>

    <aside class="issue-side" aria-label="Issue facts">
      <section class="side-block">
        <h2>Assignee</h2>
        <p>{{ names.get(record.assignee_id, "Unassigned") }}</p>
      </section>
      <section class="side-block">
        <h2>Labels</h2>
        <p class="labels">{% for name in record.domains %}{% if not loop.first %} {% endif %}{% if domain_path(name) %}<a href="{{ domain_path(name) }}">{{ name }}</a>{% else %}<span>{{ name }}</span>{% endif %}{% else %}<span class="muted">None</span>{% endfor %}</p>
      </section>
      <section class="side-block">
        <h2>Priority</h2>
        {% if can_change_priority %}
        <form class="priority-form" method="post" action="{{ url_for('records.issue_priority', issue_id=record.id) }}">
          <label class="sr-only" for="priority-select">Priority</label>
          <select id="priority-select" name="priority">
            {% for value in priorities %}
            <option value="{{ value }}"{% if record.priority.value == value %} selected{% endif %}>{{ value | capitalize }}</option>
            {% endfor %}
          </select>
          <button class="btn icon-only" type="submit" aria-label="Save priority" title="Save priority"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#check"/></svg></button>
        </form>
        {% else %}
        <p>{{ record.priority.value | capitalize }}</p>
        {% endif %}
      </section>
      <section class="side-block">
        <h2>Details</h2>
        <dl class="facts">
          <div><dt>Source request</dt><dd>{% if source_request %}<a href="{{ request_open_path(source_request) }}">Request #{{ source_request.id }}</a>{% else %}—{% endif %}</dd></div>
          <div><dt>Visibility</dt><dd>{{ record.visibility.value | capitalize }}</dd></div>
          <div><dt>Updated</dt><dd>{{ (record.updated_at | stamp_time(clock)) if record.updated_at else "—" }}</dd></div>
        </dl>
      </section>
    </aside>
  </div>
</article>
{% endblock %}
