{% extends "base.jinja" %}
{% block title %}PwedePa | Confirm edit{% endblock %}
{% block content %}
<div class="narrow">
  <h1>This edit reopens the request</h1>
  <div class="panel">
    <p>Saving reopens Request #{{ record.id }} for fresh staff review.</p>
    <form method="post" action="{{ url_for('records.request_edit_save', request_id=record.id) }}">
      {% for name, value in fields %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endfor %}
      <input type="hidden" name="confirmed" value="1">
      <div class="form-actions">
        <button class="btn primary" type="submit"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#check"/></svg>Edit anyway</button>
        <a class="btn" href="{{ request_open_path(record) }}"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#clock"/></svg>Keep it pending</a>
      </div>
    </form>
  </div>
</div>
{% endblock %}
