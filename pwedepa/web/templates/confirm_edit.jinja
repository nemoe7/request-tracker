{% extends "base.jinja" %}
{% block title %}PwedePa | Confirm edit{% endblock %}
{% block content %}
<div class="narrow">
  <h1>Heads up</h1>
  <div class="panel">
    <p>Editing a pending request sends Request #{{ record.id }} back to Open. Staff then review it again from the start.</p>
    <form method="post" action="{{ url_for('records.request_edit_save', request_id=record.id) }}">
      {% for name, value in fields %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endfor %}
      <input type="hidden" name="confirmed" value="1">
      <div class="form-actions">
        <button class="btn primary" type="submit">Edit anyway</button>
        <a class="btn" href="{{ record_path(record) }}">Keep it pending</a>
      </div>
    </form>
  </div>
</div>
{% endblock %}
