{% extends "base.jinja" %}
{% block title %}PwedePa | Site{% endblock %}
{% block content %}
<div class="admin-page">
<div class="page-head">
  <h1>Site</h1>
</div>

<section class="panel admin-section">
  <h2>Site message</h2>
  <form class="form" method="post" action="{{ url_for('admin.site_message') }}">
    <div class="field">
      <label for="site-message">Message</label>
      <textarea id="site-message" name="message" rows="3">{{ site_messages[0].message if site_messages else '' }}</textarea>
    </div>
    <div class="field">
      <label for="site-days">Expires in days</label>
      <input id="site-days" type="number" name="expires_days" min="1" placeholder="No expiry">
    </div>
    <label class="check"><input type="checkbox" name="enabled" checked> Enabled</label>
    <div class="form-actions"><button class="btn primary" type="submit"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#check"/></svg>Save message</button></div>
  </form>
</section>

<section class="panel admin-section">
  <h2>New issue</h2>
  <form class="form" method="post" action="{{ url_for('admin.create_issue') }}">
    <div class="field">
      <label for="admin-issue-title">Title</label>
      <input id="admin-issue-title" type="text" name="title" required>
    </div>
    <div class="field">
      <label for="admin-issue-description">Description</label>
      <textarea id="admin-issue-description" name="description" rows="4"></textarea>
    </div>
    <div class="field">
      <label for="admin-issue-assignee">Assignee</label>
      <select id="admin-issue-assignee" name="assignee_id">
        <option value="">Unassigned</option>
        {% for person in users %}<option value="{{ person.id }}">{{ person.display_name }}</option>{% endfor %}
      </select>
    </div>
    <div class="field">
      <label for="admin-issue-priority">Priority</label>
      <select id="admin-issue-priority" name="priority">
        {% for value in priorities %}<option value="{{ value }}">{{ value | capitalize }}</option>{% endfor %}
      </select>
    </div>
    <div class="field">
      <label for="admin-issue-visibility">Visibility</label>
      <select id="admin-issue-visibility" name="visibility">
        <option value="PRIVATE">Private</option>
        <option value="PUBLIC">Public</option>
      </select>
    </div>
    <fieldset class="field">
      <legend>Domains</legend>
      {% for domain in domains %}
      <label class="check"><input type="checkbox" name="domains" value="{{ domain.name }}"> {{ domain.name }}</label>
      {% endfor %}
    </fieldset>
    <div class="form-actions"><button class="btn primary" type="submit">Create issue</button></div>
  </form>
</section>
</div>
{% endblock %}
