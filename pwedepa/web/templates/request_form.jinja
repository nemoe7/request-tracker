{% extends "base.jinja" %}
{% block title %}PwedePa | {% if record %}Edit request #{{ record.id }}{% elif domain %}New request in {{ domain.name }}{% else %}New request{% endif %}{% endblock %}
{% block content %}
<div class="narrow form-page">
  <h1>{% if record %}Edit request{% elif domain %}New request in {{ domain.name }}{% else %}New request{% endif %}</h1>
  <form class="form panel form-2col" method="post" action="{% if record %}{{ url_for('records.request_edit_save', request_id=record.id) }}{% elif domain %}{{ url_for('records.request_create_in_domain', slug=domain.slug) }}{% else %}{{ url_for('records.request_create') }}{% endif %}">
    <div class="field field-wide">
      <label for="f-title">Title</label>
      <input id="f-title" name="title" type="text" required value="{{ record.title if record else '' }}">
    </div>
    <div class="field field-wide">
      <label for="f-description">Description</label>
      <textarea id="f-description" name="description" rows="5">{{ record.description if record else '' }}</textarea>
      <p class="help">Describe the need and expected result.</p>
    </div>
    <div class="field">
      {% if domain and not record %}
      <span class="field-label">Domain</span>
      <p class="field-static">{{ domain.name }}</p>
      <input type="hidden" name="domain" value="{{ domain.name }}">
      <p class="help">Owned by <a href="{{ url_for('records.domain_page', slug=domain.slug) }}">{{ domain.name }}</a>. <a href="{{ url_for('records.request_new') }}">Select another</a>.</p>
      {% elif record %}
      <span class="field-label">Domain</span>
      <p class="field-static">{{ record.domains | join(", ") if record.domains else "No Domain" }}</p>
      {% else %}
      <label for="f-domain">Domain</label>
      {% if domains %}
      <select id="f-domain" name="domain" required>
        {% for entry in domains %}
        <option value="{{ entry.name }}">{{ entry.name }}</option>
        {% endfor %}
      </select>
      <p class="help">One domain per request.</p>
      {% else %}
      <p class="help">No domains exist yet.</p>
      {% endif %}
      {% endif %}
    </div>
    <div class="field">
      <label for="f-visibility">Visibility</label>
      <select id="f-visibility" name="visibility">
        <option value="PRIVATE"{% if record and record.visibility.value == 'PRIVATE' %} selected{% endif %}>Private</option>
        <option value="PUBLIC"{% if record and record.visibility.value == 'PUBLIC' %} selected{% endif %}>Public</option>
      </select>
    </div>
    <div class="field">
      <label for="f-priority">Priority suggestion</label>
      <select id="f-priority" name="priority_suggestion">
        <option value="">No suggestion</option>
        {% for value in priorities %}
        <option value="{{ value }}"{% if record and record.priority_suggestion and record.priority_suggestion.value == value %} selected{% endif %}>{{ value | capitalize }}</option>
        {% endfor %}
      </select>
      <label class="check"><input type="checkbox" name="priority_unsure"{% if record and record.priority_unsure %} checked{% endif %}> I am not sure about the priority</label>
    </div>
    <div class="form-actions">
      {% if record %}<button class="btn primary" type="submit"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#check"/></svg>Save changes</button>{% else %}<button class="btn primary" type="submit"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#plus"/></svg>Create request</button>{% endif %}
      <a class="btn" href="{% if record %}{{ request_open_path(record) }}{% elif domain %}{{ url_for('records.domain_page', slug=domain.slug) }}{% else %}{{ url_for('records.requests') }}{% endif %}">Cancel</a>
    </div>
  </form>
</div>
{% endblock %}
