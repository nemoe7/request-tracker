{% extends "base.jinja" %}
{% block title %}PwedePa | {% if record %}Edit request #{{ record.id }}{% else %}New request{% endif %}{% endblock %}
{% block content %}
<div class="narrow">
  <h1>{% if record %}Edit request{% else %}New request{% endif %}</h1>
  <form class="form panel" method="post" action="{% if record %}{{ url_for('records.request_edit_save', request_id=record.id) }}{% else %}{{ url_for('records.request_create') }}{% endif %}">
    <div class="field">
      <label for="f-title">Title</label>
      <input id="f-title" name="title" type="text" required value="{{ record.title if record else '' }}">
    </div>
    <div class="field">
      <label for="f-description">Description</label>
      <textarea id="f-description" name="description" rows="5">{{ record.description if record else '' }}</textarea>
      <p class="help">Say what you need and how you will know it is finished.</p>
    </div>
    <fieldset class="field field-checks">
      <legend>Domains</legend>
      {% for domain in domains %}
      <label class="check"><input id="f-domains-{{ loop.index }}" type="checkbox" name="domains" value="{{ domain.name }}"{% if record and domain.name in record.domains %} checked{% endif %}> {{ domain.name }}</label>
      {% else %}
      <p class="help">No Domain is configured.</p>
      {% endfor %}
    </fieldset>
    <div class="field">
      <label for="f-visibility">Visibility</label>
      <select id="f-visibility" name="visibility">
        <option value="PRIVATE"{% if record and record.visibility.value == 'PRIVATE' %} selected{% endif %}>Private</option>
        <option value="PUBLIC"{% if record and record.visibility.value == 'PUBLIC' %} selected{% endif %}>Public</option>
      </select>
    </div>
    <div class="field">
      <label for="f-priority">Priority suggestion</label>
      <select id="f-priority" name="priority_suggestion">
        <option value="">No suggestion</option>
        {% for value in priorities %}
        <option value="{{ value }}"{% if record and record.priority_suggestion and record.priority_suggestion.value == value %} selected{% endif %}>{{ value | capitalize }}</option>
        {% endfor %}
      </select>
    </div>
    <label class="check"><input type="checkbox" name="priority_unsure"{% if record and record.priority_unsure %} checked{% endif %}> I am not sure about the priority</label>
    <div class="form-actions">
      {% if record %}<button class="btn primary icon-only" type="submit" aria-label="Save changes" title="Save changes"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#check"/></svg></button>{% else %}<button class="btn primary" type="submit"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#plus"/></svg>Create request</button>{% endif %}
      <a class="btn" href="{% if record %}{{ request_open_path(record) }}{% else %}{{ url_for('records.requests') }}{% endif %}">Cancel</a>
    </div>
  </form>
</div>
{% endblock %}
