{% extends "base.jinja" %}
{% from "_parts.jinja" import pill %}
{% block title %}PwedePa | Requests{% endblock %}
{% block content %}
<div class="{% if selected %}wide{% else %}list-page{% endif %}">
  <div class="page-head">
    <h1>Requests</h1>
    <a class="btn primary" href="{{ url_for('records.request_new') }}">New request</a>
  </div>

  {% if selected %}
  <section class="client-dash is-open is-main">
    <div class="panel inspector is-main">
      <a class="back-to-list" href="{{ url_for('records.requests') }}" aria-label="Back to the list" title="Back to the list"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#arrow-left"/></svg></a>
      <div class="issue-title-line">
        <h2><span class="issue-number">#{{ selected.id }}</span> {{ selected.title }}</h2>
        {{ pill(selected.status) }}
      </div>
      <p class="byline">
        <span>{{ names.get(selected.requester_id, "—") }}</span>
        <span class="sep">·</span>
        <span>{{ (selected.created_at | stamp_time(clock)) if selected.created_at else "—" }}</span>
        <span class="sep">·</span>
        <span>{{ selected.visibility.value | capitalize }}</span>
      </p>
      <div class="desc prose">{{ selected.description | prose if selected.description else "No description." }}</div>
      <a class="btn" href="{{ request_open_path(selected) }}"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#arrow-right"/></svg>Open request</a>
    </div>
  </section>
  {% else %}
  {% if mine %}
  <h2 class="section-title" id="mine">My requests</h2>
  <ul class="record-list">
    {% for record in mine %}
    <li class="record-row">
      <div class="record-row-main">
        <h2><a class="row-open" href="{{ request_open_path(record) }}">{{ record.title }}</a></h2>
        <p class="meta">{{ pill(record.status) }} <span class="id">#{{ record.id }}</span> · {{ record.visibility.value | capitalize }}{% if record.domains %} · {{ record.domains | join(", ") }}{% endif %}</p>
        {% if replies.get(record.id) %}
        <p class="reply">{{ names.get(replies[record.id].actor_id, "Someone") }} replied · {{ replies[record.id].at | stamp_time(clock) }}</p>
        {% else %}
        <p class="reply muted">No replies yet</p>
        {% endif %}
      </div>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <div class="empty panel">
    <img src="{{ url_for('static', filename='icons/icon-static.png') }}" alt="" width="48" height="48">
    <p>No requests yet.</p>
    <a class="btn primary" href="{{ url_for('records.request_new') }}"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#plus"/></svg>Make your first request</a>
  </div>
  {% endif %}
  {% endif %}

  <h2 class="section-title" id="public">Public board</h2>
  {% if public %}
  <ul class="record-list">
    {% for record in public %}
    <li class="record-row">
      <div class="record-row-main">
        <h2><a class="row-open" href="{{ request_open_path(record) }}">{{ record.title }}</a></h2>
        <p class="meta">{{ pill(record.status) }} <span class="id">#{{ record.id }}</span> · by {{ names.get(record.requester_id, "—") }}</p>
        {% if replies.get(record.id) %}
        <p class="reply">{{ names.get(replies[record.id].actor_id, "Someone") }} replied · {{ replies[record.id].at | stamp_time(clock) }}</p>
        {% else %}
        <p class="reply muted">No replies yet</p>
        {% endif %}
      </div>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="muted">No public requests from other people yet.</p>
  {% endif %}
</div>
{% endblock %}
