{% extends "base.jinja" %}
{% from "_parts.jinja" import pill %}
{% block title %}PwedePa | My requests{% endblock %}
{% block content %}
<div class="{% if selected %}wide{% else %}narrow{% endif %}">
  <div class="page-head">
    <h1>My requests</h1>
    <a class="btn primary" href="{{ url_for('records.request_new') }}">New request</a>
  </div>

  {% if selected %}
  <section class="client-dash is-open is-main">
    <div class="panel inspector is-main">
      <a class="back-to-list" href="{{ url_for('records.requests') }}" aria-label="Back to the list" title="Back to the list"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#arrow-left"/></svg></a>
      <p class="eyebrow">Request #{{ selected.id }} · by {{ names.get(selected.requester_id, "—") }}</p>
      <h2>{{ selected.title }}</h2>
      <p>{{ pill(selected.status) }}<span class="vis">{{ selected.visibility.value | capitalize }}</span></p>
      <div class="desc prose">{{ selected.description | prose if selected.description else "No description." }}</div>
      <a class="btn" href="{{ request_open_path(selected) }}"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#arrow-right"/></svg>Open request</a>
    </div>
  </section>
  {% else %}
  <section class="client-dash">
    <div class="panel inspector">
      <p class="eyebrow" id="today">Today</p>
      <h2>Your requests and the public board</h2>
      {% if recent %}
      <ul class="compact-list">
        {% for record in recent %}
        <li><a href="{{ url_for('records.requests', selected=record.id) }}">{{ record.title }}</a>{{ pill(record.status) }}</li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="muted">No requests yet.</p>
      {% endif %}
    </div>
  </section>
  {% if mine %}
  <ul class="record-list">
    {% for record in mine %}
    <li class="record-row">
      <div class="record-row-main">
        <h2><a href="{{ request_open_path(record) }}">{{ record.title }}</a></h2>
        <p class="meta">#{{ record.id }} · {{ record.visibility.value | capitalize }}{% if record.domains %} · {{ record.domains | join(", ") }}{% endif %}</p>
      </div>
      <div class="record-row-side">
        {{ pill(record.status) }}
        <a class="mini" href="{{ url_for('records.requests', selected=record.id) }}"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#arrow-right"/></svg>Open the card</a>
      </div>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <div class="empty panel">
    <img src="{{ url_for('static', filename='icons/icon-static.png') }}" alt="" width="48" height="48">
    <p>You have no requests yet.</p>
    <a class="btn primary" href="{{ url_for('records.request_new') }}"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#plus"/></svg>Make your first request</a>
  </div>
  {% endif %}
  {% endif %}

  <h2 class="section-title" id="public">Public board</h2>
  {% if public %}
  <ul class="record-list">
    {% for record in public %}
    <li class="record-row">
      <div class="record-row-main">
        <h2><a href="{{ request_open_path(record) }}">{{ record.title }}</a></h2>
        <p class="meta">#{{ record.id }} · by {{ names.get(record.requester_id, "—") }}</p>
      </div>
      <div class="record-row-side">
        {{ pill(record.status) }}
        <a class="mini" href="{{ url_for('records.requests', selected=record.id) }}"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#arrow-right"/></svg>Open the card</a>
      </div>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="muted">No public requests from other people yet.</p>
  {% endif %}
</div>
{% endblock %}
