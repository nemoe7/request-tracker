{% from "_parts.jinja" import pill, event_line, reason_modal %}
<article class="issue-page{% if pane %} is-pane{% endif %}">
  <header class="issue-head">
    <div class="issue-title-row">
      {% if back_href %}<a class="back-to-list" href="{{ back_href }}" aria-label="Back to list" title="Back to list"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#arrow-left"/></svg></a>{% endif %}
      <div class="issue-title-text">
        <div class="issue-title-line">
          <h1><span class="issue-number">#{{ record.id }}</span> {{ record.title }}</h1>
          {{ pill(record.status) }}
        </div>
        <p class="byline">
          <span>{{ names.get(record.requester_id, "—") }}</span>
          <span class="sep">·</span>
          <span>{{ (record.created_at | stamp_time(clock)) if record.created_at else "—" }}</span>
          <span class="sep">·</span>
          <span>{{ record.visibility.value | capitalize }}</span>
        </p>
      </div>
    </div>
    <div class="issue-bar">
      {% if actions or can_edit %}
      <div class="issue-actions">
        {% if actions %}
        <form class="actions" method="post" action="{{ url_for('records.request_transition', request_id=record.id) }}">
          {% if next_href %}<input type="hidden" name="next" value="{{ next_href }}">{% endif %}
          {% for target, label in actions %}
          <button class="btn{% if target == 'REJECTED' %} danger{% endif %}" type="submit" name="target" value="{{ target }}"{% if target == 'REJECTED' %} data-modal-open="reject-request-{{ record.id }}"{% endif %}>{{ label }}</button>
          {% endfor %}
          <noscript><input class="reason" type="text" name="reason" placeholder="Reason for rejecting" required></noscript>
        </form>
        {{ reason_modal("reject-request-" ~ record.id, url_for('records.request_transition', request_id=record.id), {"target": "REJECTED"}, next_href, "Reject this?", "Reject", "Reason for rejecting") }}
        {% endif %}
        {% if can_edit %}<a class="icon-btn" href="{{ url_for('records.request_edit', request_id=record.id) }}" aria-label="Edit" title="Edit"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#pencil"/></svg></a>{% endif %}
      </div>
      {% endif %}
    </div>
  </header>

  <div class="issue-layout">
    <div class="issue-main">
      <ol class="timeline">
        <li class="timeline-comment is-body">
          <div class="prose">{{ record.description | prose if record.description else "No description." }}</div>
          <p class="event-meta">{{ names.get(record.requester_id, "Someone") }} · {{ (record.created_at | stamp_time(clock)) if record.created_at else "—" }}</p>
        </li>
        {% for event in events %}
        {% if event.event_type == "request.comment" %}
        <li class="timeline-comment">
          <div class="prose">{{ event.data.get("text", "") | prose }}</div>
          <p class="event-meta">{{ names.get(event.actor_id, "Someone") }} · {{ event.at | stamp_time(clock) }}</p>
        </li>
        {% elif not event.event_type.endswith("created") %}
        {{ event_line(event, names) }}
        {% endif %}
        {% endfor %}
      </ol>

      {% if can_comment %}
      <form class="comment-form" method="post" action="{{ url_for('records.request_comment', request_id=record.id) }}">
        <label for="comment-text">Add a comment</label>
        <textarea id="comment-text" name="text" rows="3" required></textarea>
        {% if next_href %}<input type="hidden" name="next" value="{{ next_href }}">{% endif %}
        <button class="btn primary" type="submit"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#message-square"/></svg>Comment</button>
      </form>
      {% endif %}

      {% include "_sharing.jinja" %}
    </div>

    <aside class="issue-side" aria-label="Request facts">
      <section class="side-block">
        <h2>Requester</h2>
        <p>{{ names.get(record.requester_id, "—") }}</p>
      </section>
      <section class="side-block">
        <h2>Labels</h2>
        <p class="labels">{% for name in record.domains %}{% if not loop.first %} {% endif %}{% if domain_path(name) %}<a href="{{ domain_path(name) }}">{{ name }}</a>{% else %}<span>{{ name }}</span>{% endif %}{% else %}<span class="muted">None</span>{% endfor %}</p>
      </section>
      <section class="side-block">
        <h2>Priority</h2>
        <p>{% if record.priority_suggestion %}{{ record.priority_suggestion.value | capitalize }}{% elif record.priority_unsure %}Not sure{% else %}—{% endif %}</p>
      </section>
      <section class="side-block">
        <h2>Details</h2>
        <dl class="facts">
          <div><dt>Visibility</dt><dd>{{ record.visibility.value | capitalize }}</dd></div>
          <div><dt>Updated</dt><dd>{{ (record.updated_at | stamp_time(clock)) if record.updated_at else "—" }}</dd></div>
        </dl>
      </section>
    </aside>
  </div>
</article>
