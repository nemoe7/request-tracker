{% extends "base.jinja" %}
{% block title %}PwedePa | {% if announcement %}Edit announcement{% else %}New announcement{% endif %}{% endblock %}
{% block content %}
<div class="narrow">
  <p class="eyebrow">{{ domain.name }}</p>
  <h1>{% if announcement %}Edit announcement{% else %}New announcement{% endif %}</h1>
  <form class="form panel" method="post" action="{{ action }}">
    <div class="field">
      <label for="a-title">Title</label>
      <input id="a-title" name="title" type="text" required value="{{ values.title }}">
    </div>
    <div class="field">
      <label for="a-body">Body</label>
      <textarea id="a-body" name="body" rows="6" required>{{ values.body }}</textarea>
      <p class="help">{{ domain.name }} sees this announcement on its Domain page.</p>
    </div>
    <div class="form-actions">
      {% if announcement %}<button class="btn primary icon-only" type="submit" aria-label="Save announcement" title="Save announcement"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#check"/></svg></button>{% else %}<button class="btn primary" type="submit"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#megaphone"/></svg>Publish announcement</button>{% endif %}
      <a class="btn" href="{{ url_for('records.domain_page', slug=domain.slug) }}">Cancel</a>
    </div>
  </form>
</div>
{% endblock %}
