{% extends "base.jinja" %}
{% block title %}PwedePa | Admin audit{% endblock %}
{% block content %}
<div class="admin-page">
<div class="page-head">
  <h1>Audit log</h1>
  <a class="btn" href="{{ url_for('settings.settings', _anchor='admin') }}"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#arrow-left"/></svg>Settings</a>
</div>
{% if events %}
<ul class="record-list">
  {% for event in events %}
  <li class="record-row">
    <div class="record-row-main">
      <h2>{{ words(event.event_type) }}</h2>
      <p class="meta">{{ names.get(event.actor_id, "System") }} · {{ event.object_type or "—" }}{% if event.object_id %} <span class="id">#{{ event.object_id }}</span>{% endif %}</p>
    </div>
    <div class="record-row-side">
      <span class="status-word">{{ event.created_at | stamp(clock) }}</span>
    </div>
  </li>
  {% endfor %}
</ul>
{% else %}
<p class="muted">No audit events yet.</p>
{% endif %}
</div>
{% endblock %}
