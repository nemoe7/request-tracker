{% extends "base.jinja" %}
{% block title %}PwedePa | Shared record{% endblock %}
{% block content %}
<div class="narrow">
  <div class="panel empty-state">
    <img src="{{ url_for('static', filename='icons/icon-static.png') }}" alt="" width="48" height="48">
    <h1>{{ record.title }}</h1>
    <p>This link shows the record once without signing in.</p>
    <form method="post" action="{{ url_for('sharing.consume_view', token=token) }}">
      <button class="btn primary big" type="submit"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#eye"/></svg>View record once</button>
    </form>
  </div>
</div>
{% endblock %}
