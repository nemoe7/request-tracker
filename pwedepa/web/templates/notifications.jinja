{% extends "base.jinja" %}
{% from "_parts.jinja" import confirm_modal %}
{% block title %}PwedePa | Notifications{% endblock %}
{% block content %}
<div class="narrow">
  <div class="page-head">
    <h1>Notifications</h1>
    <div class="page-actions">
      {% if notices %}
      <button class="btn danger-quiet" type="button" data-modal-open="clear-notices"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#trash"/></svg>Clear all</button>
      {{ confirm_modal("clear-notices", url_for('notifications.clear'), "Clear all notifications?", "Removes all notifications. Cannot be undone.", "Clear all") }}
      {% endif %}
      <a class="btn" href="{{ url_for('settings.settings') }}"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#settings"/></svg>Notification settings</a>
    </div>
  </div>
  {% if notices %}
  <ul class="notice-list">
    {% for notice in notices %}
    <li class="notice">
      <div class="notice-main">
        <p class="notice-message">{{ notice.message }}</p>
        <p class="event-meta">{{ notice.category | capitalize }} · {{ names.get(notice.actor_id, "Someone") }} · {{ notice.created_at | stamp_time(clock) }}</p>
      </div>
      <div class="notice-side">
        {% if links.get(notice.id) %}<a class="btn" href="{{ links[notice.id] }}">Open {{ notice.object_type }}</a>{% endif %}
        <form method="post" action="{{ url_for('notifications.dismiss', notice_id=notice.id) }}">
          <button class="icon-btn" type="submit" aria-label="Dismiss notification"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#x"/></svg></button>
        </form>
      </div>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <div class="empty panel">
    <img src="{{ url_for('static', filename='icons/icon-static.png') }}" alt="" width="48" height="48">
    <p>No notifications yet.</p>
  </div>
  {% endif %}
</div>
{% endblock %}
