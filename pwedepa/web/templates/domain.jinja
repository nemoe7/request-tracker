{% extends "base.jinja" %}
{% from "_parts.jinja" import pill %}
{% block title %}PwedePa | {{ domain.name }}{% endblock %}
{% block content %}
<div class="narrow">
  <p class="eyebrow">Domain</p>
  <div class="page-head">
    <h1>{{ domain.name }}</h1>
    {% if user and not demo_mode %}
    <form method="post" action="{{ url_for('announcements.subscribe', slug=domain.slug) }}">
      <button class="btn" type="submit">{% if subscribed %}Unsubscribe{% else %}Subscribe{% endif %}</button>
    </form>
    {% endif %}
  </div>
  <p class="desc">{{ domain.description or "No description yet." }}</p>

  <h2 class="section-title">Announcements</h2>
  {% if is_staff and not demo_mode %}
  <p class="section-actions"><a class="btn" href="{{ url_for('announcements.new', slug=domain.slug) }}">New announcement</a></p>
  {% endif %}
  {% if announcements %}
  <div class="card-list">
    {% for announcement in announcements %}
    <article class="card">
      <div class="card-top">
        <h2>{{ announcement.title }}</h2>
        {% if is_staff and not demo_mode %}
        <span class="card-actions">
          <a class="icon-btn" href="{{ url_for('announcements.edit', slug=domain.slug, announcement_id=announcement.id) }}" aria-label="Edit announcement" title="Edit announcement"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#pencil"/></svg></a>
          <a class="mini" href="{{ url_for('announcements.confirm_delete', slug=domain.slug, announcement_id=announcement.id) }}">Remove</a>
        </span>
        {% endif %}
      </div>
      <p class="announcement-body">{{ announcement.body }}</p>
      <p class="meta">by {{ names.get(announcement.author_id, "—") }} · {{ announcement.published_at | stamp(clock) }}{% if announcement.edited_at %} · edited {{ announcement.edited_at | stamp(clock) }}{% endif %}</p>
    </article>
    {% endfor %}
  </div>
  {% else %}
  <p class="muted">No announcements yet.</p>
  {% endif %}

  <h2 class="section-title">Requests</h2>
  {% if requests %}
  <ul class="record-list">
    {% for record in requests %}
    <li class="record-row">
      <div class="record-row-main">
        <h2><a href="{{ request_open_path(record, domain.slug) }}">{{ record.title }}</a></h2>
        <p class="meta">#{{ record.id }} · by {{ names.get(record.requester_id, "—") }}</p>
      </div>
      <div class="record-row-side">{{ pill(record.status) }}</div>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="muted">No requests here yet.</p>
  {% endif %}

  <h2 class="section-title">Issues</h2>
  {% if issues %}
  <ul class="record-list">
    {% for record in issues %}
    <li class="record-row">
      <div class="record-row-main">
        <h2><a href="{{ record_path(record, "issue", slug=domain.slug) }}">{{ record.title }}</a></h2>
        <p class="meta">#{{ record.id }} · by {{ names.get(record.requester_id, "—") }}</p>
      </div>
      <div class="record-row-side">{{ pill(record.status) }}</div>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="muted">No issues here yet.</p>
  {% endif %}
</div>
{% endblock %}
