{% extends "base.jinja" %}
{% block title %}PwedePa | Sign in{% endblock %}
{% block content %}
{% if site_message %}
<div class="flash" role="status"><p>{{ site_message.message }}</p></div>
{% endif %}
<section class="auth-card panel">
  <h1>Sign in</h1>
  <p class="muted">Confirm your device passkey when prompted.</p>
  <button class="btn primary big" id="login-button" type="button"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#key-round"/></svg>Sign in with a passkey</button>
  <p class="status" id="status" role="status"></p>
  <p class="muted">New here? <a href="{{ url_for('pages.enroll') }}">Enroll with a token</a>.</p>
</section>
{% endblock %}
