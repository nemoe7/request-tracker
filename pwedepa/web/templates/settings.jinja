{% extends "base.jinja" %}
{% from "_parts.jinja" import modal, reason_modal %}
{% block title %}PwedePa | Settings{% endblock %}
{% block content %}
<div class="settings-shell">
  <aside class="settings-rail" aria-label="Settings sections">
    <div class="settings-profile">
      <span class="avatar big" aria-hidden="true">{{ user.display_name[0] }}</span>
      <div>
        <p class="profile-name">{{ user.display_name }}</p>
        <p class="profile-sub">@{{ user.username }} · {{ user.status.value | capitalize }}</p>
      </div>
    </div>
    <nav class="settings-nav">
      {% set show_client_view = can_view_as_client and not demo_switch %}
      {% for anchor, label, icon, tint in [("#profile", "Profile", "settings", "chip-blue"), ("#appearance", "Appearance", "contrast", "chip-indigo"), ("#notifications", "Notifications", "bell", "chip-red"), ("#passkeys", "Passkeys", "key-round", "chip-gray"), ("#admin", "Admin", "clipboard-list", "chip-amber")] %}
      {% if anchor != "#admin" or is_admin or show_client_view %}
      <a href="{{ anchor }}" data-pane="{{ anchor | replace('#', '') }}">
        <span class="set-chip {{ tint }}"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#{{ icon }}"/></svg></span>
        {{ label }}
        <svg class="icon chev" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#chevron-right"/></svg>
      </a>
      {% endif %}
      {% endfor %}
    </nav>
  </aside>

  <div class="settings-main">
    <a class="pane-back" href="#"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#chevron-left"/></svg>Settings</a>
    <h1>Settings</h1>

    <section class="set-group" id="profile" aria-label="Profile">
      <header class="pane-head">
        <h2>Profile</h2>
        <p>Name, username, and account status.</p>
      </header>
      <dl class="set-list set-facts">
        <div class="set-row"><dt class="set-label">Member since</dt><dd class="set-value">{{ user.created_at.strftime("%b %Y") if user.created_at else "—" }}</dd></div>
        <div class="set-row"><dt class="set-label">Role</dt><dd class="set-value">{{ roles }}</dd></div>
        <div class="set-row"><dt class="set-label">Last sign-in</dt><dd class="set-value">{{ (last_used | stamp_time(clock)) if last_used else "—" }}</dd></div>
      </dl>
      <form method="post" action="{{ url_for('settings.profile') }}" data-auto-submit>
        <label class="set-row">
          <span class="set-chip chip-blue"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#settings"/></svg></span>
          <span class="set-label">Profile name</span>
          <input class="set-input" type="text" name="display_name" value="{{ user.display_name }}" required>
        </label>
        <button class="set-row link-row" type="button" data-modal-open="change-username">
          <span class="set-chip chip-gray"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#inbox"/></svg></span>
          <span class="set-label">Username</span>
          <span class="set-value">{{ user.username }}</span>
          <svg class="icon chev" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#chevron-right"/></svg>
        </button>
        <div class="set-row">
          <span class="set-chip chip-green"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#circle-alert"/></svg></span>
          <span class="set-label">Status</span>
          <span class="set-value">{{ user.status.value | capitalize }}</span>
        </div>
        <div class="set-row set-action" data-save><button class="btn primary icon-only" type="submit" aria-label="Save profile" title="Save profile"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#check"/></svg></button></div>
      </form>
      {% call modal("change-username", "Change your username?", username_error is not none) %}
      <form class="modal-form" method="post" action="{{ url_for('settings.username') }}">
        <label for="change-username-field">New username</label>
        <input id="change-username-field" type="text" name="username" value="{{ username_value or user.username }}" required autofocus>
        <p class="help">Must be unique across accounts.</p>
        {% if username_error %}<p class="modal-error" role="alert">{{ username_error }}</p>{% endif %}
        <div class="modal-actions">
          <button class="btn" type="button" data-modal-close>Cancel</button>
          <button class="btn primary" type="submit">Save username</button>
        </div>
      </form>
      {% endcall %}
    </section>

    <section class="set-group" id="appearance" aria-label="Appearance">
      <header class="pane-head">
        <h2>Appearance</h2>
        <p>Theme, time format, and text size.</p>
      </header>
      <div class="set-list">
        <div class="set-row">
          <span class="set-chip chip-indigo"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#contrast"/></svg></span>
          <span class="set-label">Theme<span class="set-sub">System follows your device</span></span>
          <span class="seg-control" role="group" aria-label="Theme">
            <button type="button" data-theme-set="system"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#monitor"/></svg>System</button>
            <button type="button" data-theme-set="light"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#sun"/></svg>Light</button>
            <button type="button" data-theme-set="dark"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#moon"/></svg>Dark</button>
          </span>
        </div>
      </div>
      <form class="set-list" method="post"{% if not demo_mode %} data-clock-form{% endif %} action="{{ url_for('settings.clock') }}">
        <div class="set-row set-row-stack">
          <span class="set-chip chip-amber"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#clock"/></svg></span>
          <span class="set-label">Time format<span class="set-sub">Under 72 hours shows short, like 3h ago</span></span>
          <span class="seg-control" role="group" aria-label="Time format">
            <button type="submit" name="clock" value="12"{% if clock != "24" %} class="is-active"{% endif %}><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#clock"/></svg>12-hour</button>
            <button type="submit" name="clock" value="24"{% if clock == "24" %} class="is-active"{% endif %}><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#clock"/></svg>24-hour</button>
          </span>
        </div>
      </form>
      <p class="set-note" role="status" data-clock-status></p>
      <form class="set-list" method="post" action="{{ url_for('settings.font_size') }}" data-font-size-form>
        <div class="set-row set-row-stack">
          <span class="set-chip chip-indigo"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#type"/></svg></span>
          <span class="set-label">Text size<span class="set-sub">Percentage of base size</span></span>
          <span class="font-size-control">
            <input class="slider" type="range" min="85" max="130" step="1" value="{{ font_size }}" aria-label="Text size" data-font-size-range>
            <input class="number" type="number" name="font_size" min="85" max="130" step="1" value="{{ font_size }}" aria-label="Text size percentage" data-font-size-number>
          </span>
        </div>
        <div class="set-row set-action" data-save><button class="btn primary icon-only" type="submit" aria-label="Save text size" title="Save text size"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#check"/></svg></button></div>
      </form>
      <p class="set-note" role="status" data-font-size-status></p>
    </section>

    <section class="set-group" id="notifications" aria-label="Notifications">
      <header class="pane-head">
        <h2>Notifications</h2>
        <p>Inbox delivery and unread pip rules.</p>
      </header>
      <p class="set-note" role="status" data-autosave-status></p>
      <form class="set-list" method="post"{% if not demo_mode %} data-autosave{% endif %} action="{{ url_for('settings.notification_preferences') }}">
        {% for pref in preferences %}
        <p class="set-head">{{ pref.category | capitalize }}</p>
          <label class="set-row">
            <span class="set-chip chip-red"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#bell"/></svg></span>
            <span class="set-label">Enabled</span>
            <input class="switch" type="checkbox" name="{{ pref.category }}_enabled"{% if pref.enabled %} checked{% endif %}>
          </label>
          <label class="set-row">
            <span class="set-chip chip-blue"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#inbox"/></svg></span>
            <span class="set-label">Show in inbox</span>
            <input class="switch" type="checkbox" name="{{ pref.category }}_inbox"{% if pref.inbox_enabled %} checked{% endif %}>
          </label>
          <label class="set-row">
            <span class="set-chip chip-amber"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#circle-alert"/></svg></span>
            <span class="set-label">Show pip</span>
            <input class="switch" type="checkbox" name="{{ pref.category }}_pip"{% if pref.pip_enabled %} checked{% endif %}>
          </label>
        {% endfor %}
        <div class="set-row set-action" data-save><button class="btn primary" type="submit">Save</button></div>
      </form>
    </section>

    <section class="set-group" id="passkeys" aria-label="Passkeys">
      <header class="pane-head">
        <h2>Passkeys</h2>
        <p>Passkeys registered for this account.</p>
      </header>
      <div class="set-list">
        {% for key in passkeys %}
        <div class="set-row">
          <span class="set-chip chip-indigo"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#key-round"/></svg></span>
          <span class="set-label">Passkey<span class="set-sub">Added {{ key.created_at.strftime("%b %d, %Y") if key.created_at else "" }}</span></span>
          <button class="btn danger-quiet icon-only" type="button" data-modal-open="revoke-passkey-{{ key.id }}" aria-label="Revoke passkey" title="Revoke passkey"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#trash"/></svg></button>
          {{ reason_modal("revoke-passkey-" ~ key.id, url_for('auth.passkey_revoke', passkey_id=key.id), {}, None, title="Revoke this passkey?", submit="Revoke", hint="Reason for revoking") }}
        </div>
        {% endfor %}
        <div class="set-row set-action"><button class="btn" id="add-passkey" type="button"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#plus"/></svg>Add a passkey</button></div>
      </div>
      <p class="set-note" id="status" role="status"></p>
    </section>


    {% if is_admin or show_client_view %}
    <section class="set-group" id="admin" aria-label="Admin">
      <header class="pane-head">
        <h2>Admin</h2>
        <p>Users, audit log, share links, domains, and site settings.</p>
      </header>
      <div class="set-drill" data-admin-drill hidden></div>
      <div class="set-list" data-admin-list>
        {% if is_admin %}
        <a class="set-row link-row" data-admin-pane href="{{ url_for('admin.users') }}">
          <span class="set-chip chip-blue"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#inbox"/></svg></span>
          <span class="set-label">Users</span>
          <svg class="icon chev" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#chevron-right"/></svg>
        </a>
        <a class="set-row link-row" data-admin-pane href="{{ url_for('admin.audit') }}">
          <span class="set-chip chip-amber"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#clipboard-list"/></svg></span>
          <span class="set-label">Audit log</span>
          <svg class="icon chev" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#chevron-right"/></svg>
        </a>
        <a class="set-row link-row" data-admin-pane href="{{ url_for('admin.shares') }}">
          <span class="set-chip chip-green"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#plus"/></svg></span>
          <span class="set-label">Share links</span>
          <svg class="icon chev" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#chevron-right"/></svg>
        </a>
        <a class="set-row link-row" data-admin-pane href="{{ url_for('admin.domain_config') }}">
          <span class="set-chip chip-indigo"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#settings"/></svg></span>
          <span class="set-label">Domain config</span>
          <svg class="icon chev" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#chevron-right"/></svg>
        </a>
        <a class="set-row link-row" data-admin-pane href="{{ url_for('admin.site') }}">
          <span class="set-chip chip-amber"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#megaphone"/></svg></span>
          <span class="set-label">Site message and new issue</span>
          <svg class="icon chev" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#chevron-right"/></svg>
        </a>
        {% endif %}
        {% if show_client_view %}
        <a class="set-row link-row" href="{{ url_for('pages.view_as', mode='staff' if view_as_client else 'client') }}">
          <span class="set-chip chip-green"><svg class="icon" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#contrast"/></svg></span>
          <span class="set-label">{% if view_as_client %}Exit client view{% else %}View as client{% endif %}</span>
          <svg class="icon chev" aria-hidden="true"><use href="{{ url_for('static', filename='icons/lucide.svg') }}#chevron-right"/></svg>
        </a>
        {% endif %}
      </div>
    </section>
    {% endif %}
  </div>
</div>
{% endblock %}
